{
  "name": "piled-time",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "prod": "npm-run-all prod:client prod:server",
    "prod:client": "cd client && npm run build",
    "prod:server": "cd server && npm run build && npm run start:prod"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "npm-run-all": "^4.1.5"
  }
}
